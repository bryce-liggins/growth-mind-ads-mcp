# Copy OUTSIDE the checkout to a private file and edit locally.
# Do not paste real credential values into an agent chat.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/private/ads-credentials.json
# Set only when accessing a client through a manager; blank for direct access.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Optional legacy compatibility; current onboarding uses Cloud-project API access.
GOOGLE_ADS_DEVELOPER_TOKEN=
# Optional private directory; never point this at a public checkout.
# GROWTH_MIND_ADS_AUDIT_DIR=/absolute/path/to/private/audit
# Budget edits are disabled until the owner chooses a per-budget daily cap in account-currency micros.
GROWTH_MIND_ADS_MAX_BUDGET_MICROS=
# Removals default to disabled. Comma-separated exact operation types, only if deliberately authorized.
GROWTH_MIND_ADS_ALLOWED_REMOVE_TYPES=
